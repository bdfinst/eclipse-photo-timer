{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dev-team@bfinster": true
  },
  "extraKnownMarketplaces": {
    "bfinster": {
      "source": {
        "source": "github",
        "repo": "bdfinst/agentic-dev-team"
      }
    }
  }
}
